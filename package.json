  "homepage": "https://github.com/COWGRAMMAR/Combo-Cosmos-Phaser#readme",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "dev:lan": "vite --config vite/config.dev.mjs --host --strictPort",
